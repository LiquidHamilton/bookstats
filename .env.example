# API server
BOOKSTATS_HOST=127.0.0.1
BOOKSTATS_PORT=8787
# Comma-separated allowed browser origins in production. Leave unset for local development.
# BOOKSTATS_CORS_ORIGIN=https://kylecarroll.com,tauri://localhost,http://tauri.localhost
DATABASE_URL=postgresql://bookstats:bookstats@localhost:5432/bookstats
# Durable user-selected covers. The deploy helper preserves this directory when using the default.
# BOOKSTATS_COVER_DIR=/opt/bookstats/data/covers

# Public web address used in verification and password-reset emails.
BOOKSTATS_PUBLIC_URL=https://kylecarroll.com/bookstats/

# Resend transactional email. Verify kylecarroll.com in Resend, then create
# an API key with sending access. The From address may be any address on the
# verified domain; it does not have to be a separate mailbox.
# BOOKSTATS_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BOOKSTATS_EMAIL_FROM=BookStats <bookstats@kylecarroll.com>
# Optional: replies to automated messages can go to a monitored mailbox.
# BOOKSTATS_EMAIL_REPLY_TO=bookstats@kylecarroll.com
# Optional: destination for in-app bug reports/feature suggestions. Defaults to EMAIL_REPLY_TO.
# BOOKSTATS_FEEDBACK_TO=bookstats@kylecarroll.com

# Identify BookStats to Open Library. For anything beyond personal/local testing,
# replace this with a contact address you actually monitor.
BOOKSTATS_METADATA_USER_AGENT=BookStats/1.0.4 (you@example.com)

# Optional metadata providers. These credentials stay on the BookStats API server and
# are never embedded in the browser bundle. Open Library remains available without a key.
# Google Books: enable the Books API in Google Cloud and create an API key.
# BOOKSTATS_GOOGLE_BOOKS_API_KEY=AIza...
# Hardcover: create an API token from your Hardcover account API settings.
# BOOKSTATS_HARDCOVER_API_TOKEN=...

# Client API address. In development the default is already http://127.0.0.1:8787/api/v1.
# For deployed web/desktop builds set this before building, for example:
# VITE_BOOKSTATS_API_URL=https://kylecarroll.com/bookstats/api/v1
